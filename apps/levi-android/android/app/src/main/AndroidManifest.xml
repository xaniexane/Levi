<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebView needs network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- BiometricPrompt app lock (normal permission, granted at install). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Notification channels ("Messaging channels", "Notifications" rows). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Coarse location for the "location_coarse" device tool (network/IP-based
         estimate only). Runtime permission: the tool fails closed until granted,
         and the location is read only when the tool is invoked — never tracked. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Package visibility (API 30+) for the device tools' intent checks:
         resolveActivity() must see the handlers, otherwise the tools would
         wrongly report "no_handler". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.provider.AlarmClock.ACTION_SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.provider.AlarmClock.ACTION_SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application
        android:name=".LeviApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.LEVI"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- Cleartext is DENIED globally. network_security_config.xml
             allow-lists it only for loopback hosts (on-device Termux
             server, emulator host). LAN / public servers must use HTTPS:
             ServerConfig rejects http:// for non-local hosts. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- App-lock gate. Never exported: only this app can show it. -->
        <activity
            android:name=".LockActivity"
            android:exported="false" />

        <!-- Shares data-export / issue-report files from cache only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
