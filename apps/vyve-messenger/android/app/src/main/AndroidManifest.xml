<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cybrus.vyve"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biometric unlock for the local vault (SQLCipher passphrase gate) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Sync/completion notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometric hardware feature (optional) -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <application
        android:name=".VYVEApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VYVE"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth redirect — NOT exported while OAuth is unwired. When OAuth
             is wired, replace the custom scheme below with a VERIFIED App
             Link (https:// + android:autoVerify="true" on the intent-filter)
             plus per-request `state` and PKCE; a custom scheme left exported
             lets any installed app intercept the callback and steal the
             authorization code. -->
        <activity
            android:name=".auth.OAuthCallbackActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vyve"
                    android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Background sync service (not a foreground service) -->
        <service
            android:name=".net.MessageSyncService"
            android:enabled="true"
            android:exported="false" />

    </application>
</manifest>
