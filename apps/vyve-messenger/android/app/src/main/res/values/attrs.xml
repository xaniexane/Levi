<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom theme attributes set by Theme.VYVE (themes.xml). None of these
         are declared by Material3/AppCompat, so the app must declare them or
         resource linking fails with "style attribute ... not found". -->
    <attr name="colorBackground" format="color|reference" />
    <attr name="colorTextPrimary" format="color|reference" />
    <attr name="colorTextSecondary" format="color|reference" />
    <attr name="colorOnAccent" format="color|reference" />
</resources>
