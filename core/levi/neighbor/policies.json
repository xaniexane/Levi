  "no_contact_hiding": true,
  "notify": {
    "_comment": "Push plumbing (notify.py). app_push = this run's final message reaches the phone as push when the app is closed (poll-based, not instant). webhook_urls = Google Sheets Apps Script /exec URL or ntfy topic (the URL is a secret \u2014 never logged). whatsapp is declared-but-gated until a schedule is created from the WhatsApp side chat. interval_minutes is the nudge-drain cadence.",
    "backends": [
      "app_push",
      "file"
    ],
    "interval_minutes": 30,
    "max_retries": 2,
    "timeout_secs": 10,
    "webhook_urls": []
